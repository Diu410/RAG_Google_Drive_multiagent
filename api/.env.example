LLAMA_SERVER_URL=http://127.0.0.1:8081
# Relative model paths resolve under the application data directory.
LLAMA_MODEL_PATH=models/chat.gguf
# Optional larger local model; see docs/llama-runtime.md for memory and latency.
# LLAMA_MODEL_PATH=models/Qwen3.5-9B-Q4_K_M.gguf
# Installed alternatives also appear in the chat model selector.
# LLAMA_MODEL_PATH=models/Qwen3.5-9B-Q3_K_M.gguf
# LLAMA_MODEL_PATH=models/gemma-4-E4B_q4_0-it.gguf
LLAMA_MODEL_ALIAS=assistant
LLAMA_DEFAULT_PROFILE=BALANCED
LLAMA_CONTEXT_SIZE=4096
LLAMA_GPU_LAYERS=auto
LLAMA_THREADS=6
LLAMA_BATCH_SIZE=256
LLAMA_MAX_TOKENS=2048
LLAMA_AUTOSTART=true
LLAMA_STARTUP_TIMEOUT=180
LLAMA_REQUEST_TIMEOUT=120
# Elapsed budgets shared by the whole response chain; HTTP read timeout is separate.
LLAMA_FAST_REQUEST_SECONDS=120
LLAMA_BALANCED_REQUEST_SECONDS=180
LLAMA_REASONING_REQUEST_SECONDS=240
LLAMA_GENERATION_SECONDS=90
LLAMA_REASONING_GENERATION_SECONDS=120
# LLAMA_SERVER_EXECUTABLE=C:/path/to/llama-server.exe
# LLAMA_PROFILES_FILE=C:/path/to/profiles.json
EMBEDDING_BACKEND=llama
EMBEDDING_SERVER_URL=http://127.0.0.1:8082
EMBEDDING_MODEL_PATH=models/nomic-embed-text.gguf
EMBEDDING_MODEL_ALIAS=nomic-embed-text
EMBEDDING_CONTEXT_SIZE=4096
EMBEDDING_GPU_LAYERS=0
EMBEDDING_DIMENSIONS=768
EMBEDDING_BATCH_SIZE=16
# External embedding backends require an immutable model digest/version.
# EMBEDDING_MODEL_ID=sha256-of-the-external-model
# Only for a verified legacy index that already uses exactly the configured model:
# EMBEDDING_LEGACY_ADOPT=true
FAST_CHAT_NUM_PREDICT=2048
RAG_LLM_NUM_PREDICT=2048
COMPLEX_LLM_NUM_PREDICT=3072
VERIFIER_ENABLED=true
# contextual preserves the draft and reviews it in context; strict uses the legacy fact gate.
ANSWER_REVIEW_MODE=contextual
VERIFIER_CONFIDENCE_THRESHOLD=0.55
MAX_VERIFICATION_RETRIES=1
# Isolated semantic audits: 2 claims per request, 1 disables batching.
EVIDENCE_AUDIT_BATCH_SIZE=2
VERIFIER_RETRIEVAL_WEIGHT=0.30
VERIFIER_CLAIM_SUPPORT_WEIGHT=0.50
VERIFIER_SOURCE_AGREEMENT_WEIGHT=0.20
FAST_RETRIEVAL_K=6
FAST_CONTEXT_CHUNKS=3
ROUTER_LLM_FALLBACK=true
# Strategies for automatic claim verification in ANSWER_REVIEW_MODE=strict.
VERIFIER_AUTO_STRATEGIES=FACT_LOOKUP,DOCUMENT_COMPARISON,DEEP_ANALYSIS,GRAPH_QUERY
MAX_UPLOAD_BYTES=209715200
# Local API token is generated on each launch; desktop passes it through IPC.
# For a separate local automation client, inject KONTUR_API_TOKEN in its process environment.
MAX_JSON_REQUEST_BYTES=8388608
MAX_EXTRACTED_CHARACTERS=2000000
MAX_DOCX_XML_BYTES=16777216
MAX_PDF_PAGES=500
MAX_OCR_PIXELS=20000000
EXTRACTION_SECONDS=120
EXTRACTION_CONCURRENCY=2
MAX_DRIVE_FILES=200
MAX_DRIVE_DEPTH=12
MAX_DRIVE_BYTES=268435456
MAX_DRIVE_SECONDS=300
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_LANGUAGE=ru
# Optional local CosyVoice checkout and downloaded model. Until configured,
# Live mode uses the operating system voice through browser speech synthesis.
# COSYVOICE_ROOT=C:/AI/CosyVoice
# COSYVOICE_MODEL_DIR=C:/AI/CosyVoice/pretrained_models/Fun-CosyVoice3-0.5B
# For zero-shot voice cloning, configure both fields below.
# COSYVOICE_PROMPT_AUDIO=C:/AI/voices/assistant.wav
# COSYVOICE_PROMPT_TEXT=Точный текст, произнесённый в образце голоса.
# Or use a speaker included in an SFT model:
# COSYVOICE_SPEAKER=
COSYVOICE_SPEED=1.0
GRAPH_BATCH_CHUNKS=16
GRAPH_BATCH_MAX_CHARS=9000
GRAPH_LLM_NUM_PREDICT=1400
# Automatic document links from existing embeddings (no extra LLM calls).
SEMANTIC_GRAPH_SIMILARITY=0.82
SEMANTIC_GRAPH_NEIGHBORS=3
# Query-directed reference graph; conservative fallback to ordinary retrieval.
GRAPH_RETRIEVAL_ENABLED=true
